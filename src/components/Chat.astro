---
import LayerMessages from '../components/LayerMessages.astro';
import LayerHeader from '../components/LayerHeader.astro';
import LayerInput from '../components/LayerInput.astro';
import MobileEmojiPicker from '../components/MobileEmojiPicker.astro';
import UserRegister from '../components/UserRegister.astro';
import ReplyPopup from '../components/ReplyPopup.astro';
import ScrollButton from '../components/ScrollButton.astro';
import Modals from '../components/Modals.astro';
---

<LayerMessages />
<LayerHeader />
<LayerInput>
  <MobileEmojiPicker slot="picker" />
</LayerInput>
<UserRegister />
<ReplyPopup />
<ScrollButton />
<Modals />

<!--<script>-->
<!--  import { initThemeManager } from '../scripts/Modals/themeManager.js';-->
<!--  initThemeManager();-->
<!--</script>-->
<script type="module">
  // Usa importación absoluta desde la raíz del proyecto
  import { initTheme } from '/src/scripts/Theme/initTheme.js';
  
  document.addEventListener('DOMContentLoaded', () => {
    window.themeManager = initTheme();
  });
</script>

<script>
  const input = document.getElementById("input");
  input.addEventListener("input", () => {
    if (input.innerHTML === "<br>" || input.innerHTML.trim() === "") {
      input.innerHTML = "";
    }
  });
</script>

<script>
  import { initEmojiPickerButton } from '../scripts/Emojis/EmojiPickerButton.js';
  initEmojiPickerButton();
</script>

<script>
  import { initActionMenu } from '../scripts/Modals/ActionMenu.js';
  initActionMenu();
</script>
